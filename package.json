{
  "name": "nanofuzz-examples",
  "version": "0.3.5",
  "dependencies": {
    "@nanofuzz/cli": "^0.4.1"
  },
  "devDependencies": {
    "@nanofuzz/runtime": "0.4.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "tslib": "^2.8.1",
    "typescript": "5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "modulePaths": [
      "node_modules",
      "<rootDir>/examples/typescript/",
      "<rootDir>/examples/"
    ],
    "testPathIgnorePatterns": [
      "build/",
      "_build/",
      "tests/cli_smoke.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/_build/"
    ]
  },
  "scripts": {
    "test": "jest --watchAll=false",
    "test:cli": "jest tests/cli_smoke.test.ts --testPathIgnorePatterns=build/ --testPathIgnorePatterns=_build/ --watchAll=false --runInBand",
    "test:all": "jest --testPathIgnorePatterns=build/ --testPathIgnorePatterns=_build/ --watchAll=false"
  }
}