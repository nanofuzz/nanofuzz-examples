// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "Node.js, Python, Rust, Java, OCaml & Go",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "default"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": true,
      "mavenVersion": "3.9.6"
    },
    "ghcr.io/devcontainers-extra/features/ocaml-opam:1": {
      "version": "5.2.0",
      "additionalPackages": "dune yojson msgpck ounit2"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    }
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "python3 -m pip install -r requirements.txt && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && yarn install && cargo build && mvn test && opam pin add nanofuzz_runtime https://github.com/nanofuzz/nanofuzz/releases/download/v0.4.1/nanofuzz_runtime-0.4.1.tar.gz -y && opam exec -- dune runtest && go test ./tests/go/...",

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "[java]": {
          "editor.defaultFormatter": "redhat.java"
        }
      },
      "extensions": [
        "penrose.nanofuzz@0.4.1",
        "firsttris.vscode-jest-runner",
        "ms-python.python",
        "rust-lang.rust-analyzer",
        "vscjava.vscode-java-pack",
        "ocamllabs.ocaml-platform",
        "golang.go"
      ]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
