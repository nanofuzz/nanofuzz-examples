{
  // Force markdown files to open in preview
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  // Use the repository's TypeScript environment
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "python.terminal.activateEnvironment": true,
  // Hide NaNofuzz button on validator functions
  "nanofuzz.ui.codeLens.includeValidators": false,
  "editor.formatOnSave": true,
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "java.project.resourceFilters": ["node_modules", "\\.git", "target"]
}
